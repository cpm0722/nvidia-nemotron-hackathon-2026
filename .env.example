# Copy to .env and fill in. docker-compose reads .env automatically.

# super-120b endpoint (validators × 7, reporter)
SUPER_MODEL_BASE_URL=https://model-server-uya78rbya.brevlab.com/v1
SUPER_MODEL_API_KEY=empty

# nano endpoint (query-generator)
NANO_MODEL_BASE_URL=https://model-server-4dfr8gv78.brevlab.com/v1
NANO_MODEL_API_KEY=empty

# host port that maps to the orchestrator container's :10000 front-end
ORCHESTRATOR_HOST_PORT=10000

# Selective collector deploy. Keep these two variables in sync:
#   COMPOSE_PROFILES   — which collector services docker compose starts.
#                        Each collector's validator+extractor is tagged with
#                        its own name and "all"; use "all" for every collector
#                        or a comma list like "arcalive,geeknews".
#   ENABLED_COLLECTORS — which collectors orchestrator's collect_evidence calls.
# Valid names: arcalive, arxiv, benchmark, geeknews, lobsters, openai, reddit.
COMPOSE_PROFILES=all
ENABLED_COLLECTORS=arcalive,arxiv,benchmark,geeknews,lobsters,openai,reddit
